{

  "mcpServers": {

    "fetch": {

      "command": "uvx",

      "args": ["mcp-server-fetch"]

    },

    "context7": {

      "command": "npx",

      "args": ["-y", "@upstash/context7-mcp", "--api-key", "${CTX7_API_KEY}"]

    },

    "openweathermap": {
      "command": "uvx",
      "args": ["weather-mcp-server"],
      "env": {
        "OPENWEATHER_API_KEY": "${OWM_API_KEY}"
      }
    }

  }

}

